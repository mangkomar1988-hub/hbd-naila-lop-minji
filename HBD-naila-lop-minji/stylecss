/* BACKGROUND */
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #ffd6e7, #ffb6d5, #fce4ec);
    color: #7b2450;
}

/* KARTU UTAMA */
.card {
    width: 100%;
    max-width: 450px;
    padding: 30px 22px;
    text-align: center;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 25px;
    box-shadow: 0 12px 35px rgba(180, 60, 110, 0.2);
    animation: muncul 1s ease;
}

/* JUDUL */
h1, h2 {
    color: #e75480;
}

h1 {
    font-size: 32px;
}

p {
    line-height: 1.7;
}

/* TOMBOL */
button {
    border: none;
    border-radius: 25px;
    padding: 13px 22px;
    margin: 8px;
    background: #ff69a6;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.25s;
}

button:hover {
    background: #e84387;
    transform: scale(1.05);
}

/* BAGIAN KEJUTAN */
#letter, #final {
    display: none;
    margin-top: 20px;
    padding: 18px;
    background: #fff0f6;
    border-radius: 18px;
    animation: muncul 0.7s ease;
}

/* HATI MELAYANG */
.floating {
    position: fixed;
    bottom: -30px;
    font-size: 24px;
    pointer-events: none;
    animation: terbang 3s linear forwards;
    z-index: 10;
}

/* ANIMASI */
@keyframes muncul {
    from {
        opacity: 0;
        transform: translateY(15px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes terbang {
    from {
        transform: translateY(0) rotate(0deg);
        opacity: 1;
    }

    to {
        transform: translateY(-110vh) rotate(360deg);
        opacity: 0;
    }
}

/* TAMPILAN HP */
@media (max-width: 480px) {
    .card {
        padding: 24px 16px;
    }

    h1 {
        font-size: 27px;
    }

    button {
        font-size: 14px;
    }
}